# ============================================================
#  LearnPath Backend — Environment Variables Template
#  COPY this file to .env and fill in your values.
#  The real .env is GITIGNORED and must never be committed.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL password for learnpath_user
DB_PASSWORD=change_me_to_a_strong_password

# ── JWT ──────────────────────────────────────────────────────
# HMAC-SHA256 signing secret — minimum 32 characters (256 bits).
# Generate with: openssl rand -base64 64
JWT_SECRET=learnpath-super-secure-jwt-secret-key-2026-backend-auth-system

# Access token lifetime in minutes (default: 15)
JWT_ACCESS_TTL_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────
# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Spring Profile ───────────────────────────────────────────
# "dev" for local development, "prod" for production
SPRING_PROFILES_ACTIVE=dev

# ── Logging ───────────────────────────────────────────────────
# DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
